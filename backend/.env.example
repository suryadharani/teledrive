# TeleDrive Backend - Telegram MTProto Configuration
# Obtain your API ID and API HASH from https://my.telegram.org (Log in -> "API development tools")

TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Private Telegram Channel ID where files will be stored (e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=-1001234567890

# Companion HTTP Server Port (Default: 8765)
PORT=8765
