# ==========================================
# TeleDrive - Environment Configuration
# ==========================================
# Copy this file to `.env` and fill in your Firebase project values.
# TeleDrive works in a local Demo/Sandbox mode if these variables are empty.

# Firebase Web App Credentials (from Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Storage Provider Configuration
# Options: 'mock' (default for development/demo) or 'local_companion' (for local Mac daemon)
VITE_DEFAULT_STORAGE_PROVIDER=mock

# Local Companion Backend URL (Runs on your Mac at http://127.0.0.1:8765)
VITE_TELEGRAM_COMPANION_URL=http://127.0.0.1:8765
